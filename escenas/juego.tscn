[sub_resource type="Resource" id="Resource_utwd3"]
script = ExtResource("42_6hie0")
items_requeridos = Array[String](["Llave de la tienda"])
texto = Array[String](["Mi llave! Muchisimas gracias!!", "Perdona que no me presenté antes, estaba muy preocupado.", "Soy Luis, el dueño de la única tienda del pueblo.", "Es un gusto que hayas llegado!", "Mientras buscaba encontré esto, tal vez te sirva de algo...", "Tomalo como regalo de bienvenida JAJAJA"])
flags_a_activar = Array[String](["tendero_agradecido"])
item_a_dar = "Linterna"
items_a_quitar = Array[String](["LLave de la tienda"])
objetivo_nuevo = "Seguir explorando el pueblo"
metadata/_custom_type_script = "uid://du47wn6gexhp2"

