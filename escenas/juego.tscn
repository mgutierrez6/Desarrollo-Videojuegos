texto = Array[String](["Espero que no esté en la fuente..."])
metadata/_custom_type_script = "uid://du47wn6gexhp2"

[sub_resource type="Resource" id="Resource_0666g"]
script = ExtResource("42_6hie0")
texto = Array[String](["Perdí la llave de la tienda y no pude abrir en todo el dia!!", "La estoy buscando...", "Pero estuve por todos lados... ", "Solo me falta revisar en estos arbustos y en la fuente", "Espero que no esté en la fuente..."])
flags_a_activar = Array[String](["luis_primer"])
objetivo_nuevo = "Ayudar al señor con su llave"
marca_pendiente = true
metadata/_custom_type_script = "uid://du47wn6gexhp2"

